{
  "manifest_version": 3,
  "name": "PPTX Viewer",
  "version": "0.1.0",
  "description": "Open .pptx files directly in your browser — no upload, no server, 100% client-side.",
  "permissions": ["downloads", "notifications", "contextMenus"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open a PPTX file",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
